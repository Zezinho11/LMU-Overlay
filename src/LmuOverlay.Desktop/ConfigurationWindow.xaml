<Window x:Class="LmuOverlay.Desktop.ConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LMU Overlay — Configuração"
        Width="650" Height="610"
        MinWidth="620" MinHeight="570"
        WindowStartupLocation="CenterScreen"
        Background="#FF0B1117"
        Foreground="White">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="REDFOX RACING"
                   Foreground="#FF42D3A6"
                   FontFamily="Bahnschrift"
                   FontWeight="Bold"
                   FontSize="22" />
        <TextBlock Grid.Row="1"
                   Text="PERFIS DE LAYOUT"
                   Foreground="#FF788795"
                   FontWeight="Bold"
                   FontSize="10"
                   Margin="0,14,0,5" />
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ProfileSelector"
                      Grid.Column="0"
                      Height="32"
                      Margin="0,0,8,0"
                      VerticalContentAlignment="Center"
                      SelectionChanged="ProfileSelectionChanged" />
            <Button Grid.Column="1" Content="Novo"
                    Click="NewProfileClicked" Padding="12,6" Margin="0,0,6,0" />
            <Button Grid.Column="2" Content="Duplicar"
                    Click="DuplicateProfileClicked" Padding="12,6" Margin="0,0,6,0" />
            <Button Grid.Column="3" Content="Renomear"
                    Click="RenameProfileClicked" Padding="12,6" Margin="0,0,6,0" />
            <Button Grid.Column="4" Content="Excluir"
                    Click="DeleteProfileClicked" Padding="12,6" />
            <StackPanel Grid.Row="1" Grid.ColumnSpan="5"
                        Orientation="Horizontal" Margin="0,9,0,0">
                <Button Content="Importar perfil"
                        Click="ImportProfileClicked" Padding="12,6" Margin="0,0,6,0" />
                <Button Content="Exportar perfil"
                        Click="ExportProfileClicked" Padding="12,6" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="54" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="VISIBILIDADE"
                       Foreground="#FF788795" FontWeight="Bold" FontSize="10" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="OPACIDADE"
                       Foreground="#FF788795" FontWeight="Bold" FontSize="10" />

            <CheckBox x:Name="DashboardVisible" Grid.Row="1" Grid.Column="0"
                      Content="Dashboard RedFox" VerticalAlignment="Center" />
            <Slider x:Name="DashboardOpacity" Grid.Row="1" Grid.Column="1"
                    Minimum="0.2" Maximum="1" TickFrequency="0.05"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"
                       Text="{Binding ElementName=DashboardOpacity, Path=Value, StringFormat={}{0:P0}}" />

            <CheckBox x:Name="InputsVisible" Grid.Row="2" Grid.Column="0"
                      Content="Inputs" VerticalAlignment="Center" />
            <Slider x:Name="InputsOpacity" Grid.Row="2" Grid.Column="1"
                    Minimum="0.2" Maximum="1" TickFrequency="0.05"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"
                       Text="{Binding ElementName=InputsOpacity, Path=Value, StringFormat={}{0:P0}}" />

            <CheckBox x:Name="StandingsVisible" Grid.Row="3" Grid.Column="0"
                      Content="Live Standings" VerticalAlignment="Center" />
            <Slider x:Name="StandingsOpacity" Grid.Row="3" Grid.Column="1"
                    Minimum="0.2" Maximum="1" TickFrequency="0.05"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Row="3" Grid.Column="2" VerticalAlignment="Center"
                       Text="{Binding ElementName=StandingsOpacity, Path=Value, StringFormat={}{0:P0}}" />

            <CheckBox x:Name="RelativeVisible" Grid.Row="4" Grid.Column="0"
                      Content="Relative" VerticalAlignment="Center" />
            <Slider x:Name="RelativeOpacity" Grid.Row="4" Grid.Column="1"
                    Minimum="0.2" Maximum="1" TickFrequency="0.05"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Row="4" Grid.Column="2" VerticalAlignment="Center"
                       Text="{Binding ElementName=RelativeOpacity, Path=Value, StringFormat={}{0:P0}}" />

            <CheckBox x:Name="SessionVisible" Grid.Row="5" Grid.Column="0"
                      Content="Session / Flags" VerticalAlignment="Center" />
            <Slider x:Name="SessionOpacity" Grid.Row="5" Grid.Column="1"
                    Minimum="0.2" Maximum="1" TickFrequency="0.05"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Row="5" Grid.Column="2" VerticalAlignment="Center"
                       Text="{Binding ElementName=SessionOpacity, Path=Value, StringFormat={}{0:P0}}" />

            <CheckBox x:Name="FuelVisible" Grid.Row="6" Grid.Column="0"
                      Content="Fuel / Virtual Energy" VerticalAlignment="Center" />
            <Slider x:Name="FuelOpacity" Grid.Row="6" Grid.Column="1"
                    Minimum="0.2" Maximum="1" TickFrequency="0.05"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Row="6" Grid.Column="2" VerticalAlignment="Center"
                       Text="{Binding ElementName=FuelOpacity, Path=Value, StringFormat={}{0:P0}}" />
        </Grid>
        <DockPanel Grid.Row="4" Margin="0,20,0,0">
            <Button Content="Restaurar perfil"
                    Click="ResetClicked"
                    Padding="14,8"
                    Background="#FF202A33"
                    Foreground="White"
                    BorderBrush="#FF394957" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Fechar"
                        Click="CloseClicked"
                        Padding="18,8"
                        Margin="0,0,8,0"
                        Background="#FF202A33"
                        Foreground="White"
                        BorderBrush="#FF394957" />
                <Button Content="Aplicar"
                        Click="ApplyClicked"
                        Padding="18,8"
                        Background="#FF15765F"
                        Foreground="White"
                        BorderBrush="#FF42D3A6"
                        FontWeight="Bold" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
