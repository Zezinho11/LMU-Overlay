<Window x:Class="LmuOverlay.Desktop.ConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LMU Overlay — Configuração"
        Width="900" Height="780"
        MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#FF0B1117"
        Foreground="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
    <Grid Margin="22" MinWidth="760">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="REDFOX RACING"
                   Foreground="#FF42D3A6"
                   FontFamily="Bahnschrift"
                   FontWeight="Bold"
                   FontSize="22" />
        <TextBlock Grid.Row="1"
                   Text="PERFIS DE LAYOUT"
                   Foreground="#FF788795"
                   FontWeight="Bold"
                   FontSize="10"
                   Margin="0,14,0,5" />
        <TextBlock x:Name="CompatibilityStatus"
                   Grid.Row="1"
                   HorizontalAlignment="Right"
                   Foreground="#FF94A3B8"
                   FontSize="10"
                   Margin="0,14,0,5" />
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ProfileSelector"
                      Grid.Column="0"
                      Height="32"
                      Margin="0,0,8,0"
                      VerticalContentAlignment="Center"
                      SelectionChanged="ProfileSelectionChanged" />
            <Button Grid.Column="1" Content="Novo"
                    Click="NewProfileClicked" Padding="12,6" Margin="0,0,6,0" />
            <Button Grid.Column="2" Content="Duplicar"
                    Click="DuplicateProfileClicked" Padding="12,6" Margin="0,0,6,0" />
            <Button Grid.Column="3" Content="Renomear"
                    Click="RenameProfileClicked" Padding="12,6" Margin="0,0,6,0" />
            <Button Grid.Column="4" Content="Excluir"
                    Click="DeleteProfileClicked" Padding="12,6" />
            <StackPanel Grid.Row="1" Grid.ColumnSpan="5"
                        Orientation="Horizontal" Margin="0,9,0,0">
                <Button Content="Importar perfil"
                        Click="ImportProfileClicked" Padding="12,6" Margin="0,0,6,0" />
                <Button Content="Exportar perfil"
                        Click="ExportProfileClicked" Padding="12,6" Margin="0,0,6,0" />
                <Button Content="Exportar diagnóstico"
                        Click="ExportDiagnosticsClicked" Padding="12,6" />
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.ColumnSpan="5"
                        Orientation="Horizontal" Margin="0,9,0,0">
                <TextBlock Text="PRESET" Foreground="#FF788795"
                           FontWeight="Bold" FontSize="10"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="PresetSelector" Width="180" Height="28"
                          VerticalContentAlignment="Center" />
                <Button Content="Aplicar preset" Click="ApplyPresetClicked"
                        Padding="12,6" Margin="7,0,0,0" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="54" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="54" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="VISIBILIDADE"
                       Foreground="#FF788795" FontWeight="Bold" FontSize="10" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="FUNDO"
                       Foreground="#FF788795" FontWeight="Bold" FontSize="10" />
            <TextBlock Grid.Row="0" Grid.Column="3" Text="ESCALA"
                       Foreground="#FF788795" FontWeight="Bold" FontSize="10" />

            <CheckBox x:Name="DashboardVisible" Grid.Row="1" Grid.Column="0"
                      Content="Dashboard RedFox" VerticalAlignment="Center" />
            <Slider x:Name="DashboardOpacity" Grid.Row="1" Grid.Column="1"
                    Minimum="0.2" Maximum="1" TickFrequency="0.05"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"
                       Text="{Binding ElementName=DashboardOpacity, Path=Value, StringFormat={}{0:P0}}" />
            <Slider x:Name="DashboardScale" Grid.Row="1" Grid.Column="3"
                    Minimum="0.5" Maximum="2" TickFrequency="0.05"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="4" VerticalAlignment="Center"
                       Text="{Binding ElementName=DashboardScale, Path=Value, StringFormat={}{0:0.00}x}" />

            <CheckBox x:Name="InputsVisible" Grid.Row="2" Grid.Column="0"
                      Content="Inputs" VerticalAlignment="Center" />
            <Slider x:Name="InputsOpacity" Grid.Row="2" Grid.Column="1"
                    Minimum="0.2" Maximum="1" TickFrequency="0.05"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"
                       Text="{Binding ElementName=InputsOpacity, Path=Value, StringFormat={}{0:P0}}" />
            <Slider x:Name="InputsScale" Grid.Row="2" Grid.Column="3"
                    Minimum="0.5" Maximum="2" TickFrequency="0.05"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="4" VerticalAlignment="Center"
                       Text="{Binding ElementName=InputsScale, Path=Value, StringFormat={}{0:0.00}x}" />

            <CheckBox x:Name="StandingsVisible" Grid.Row="3" Grid.Column="0"
                      Content="Live Standings" VerticalAlignment="Center" />
            <Slider x:Name="StandingsOpacity" Grid.Row="3" Grid.Column="1"
                    Minimum="0.2" Maximum="1" TickFrequency="0.05"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Row="3" Grid.Column="2" VerticalAlignment="Center"
                       Text="{Binding ElementName=StandingsOpacity, Path=Value, StringFormat={}{0:P0}}" />
            <Slider x:Name="StandingsScale" Grid.Row="3" Grid.Column="3"
                    Minimum="0.5" Maximum="2" TickFrequency="0.05"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Row="3" Grid.Column="4" VerticalAlignment="Center"
                       Text="{Binding ElementName=StandingsScale, Path=Value, StringFormat={}{0:0.00}x}" />

            <CheckBox x:Name="RelativeVisible" Grid.Row="4" Grid.Column="0"
                      Content="Relative" VerticalAlignment="Center" />
            <Slider x:Name="RelativeOpacity" Grid.Row="4" Grid.Column="1"
                    Minimum="0.2" Maximum="1" TickFrequency="0.05"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Row="4" Grid.Column="2" VerticalAlignment="Center"
                       Text="{Binding ElementName=RelativeOpacity, Path=Value, StringFormat={}{0:P0}}" />
            <Slider x:Name="RelativeScale" Grid.Row="4" Grid.Column="3"
                    Minimum="0.5" Maximum="2" TickFrequency="0.05"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Row="4" Grid.Column="4" VerticalAlignment="Center"
                       Text="{Binding ElementName=RelativeScale, Path=Value, StringFormat={}{0:0.00}x}" />

            <CheckBox x:Name="SessionVisible" Grid.Row="5" Grid.Column="0"
                      Content="Session / Flags" VerticalAlignment="Center" />
            <Slider x:Name="SessionOpacity" Grid.Row="5" Grid.Column="1"
                    Minimum="0.2" Maximum="1" TickFrequency="0.05"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Row="5" Grid.Column="2" VerticalAlignment="Center"
                       Text="{Binding ElementName=SessionOpacity, Path=Value, StringFormat={}{0:P0}}" />
            <Slider x:Name="SessionScale" Grid.Row="5" Grid.Column="3"
                    Minimum="0.5" Maximum="2" TickFrequency="0.05"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Row="5" Grid.Column="4" VerticalAlignment="Center"
                       Text="{Binding ElementName=SessionScale, Path=Value, StringFormat={}{0:0.00}x}" />

            <CheckBox x:Name="FuelVisible" Grid.Row="6" Grid.Column="0"
                      Content="Fuel / Virtual Energy" VerticalAlignment="Center" />
            <Slider x:Name="FuelOpacity" Grid.Row="6" Grid.Column="1"
                    Minimum="0.2" Maximum="1" TickFrequency="0.05"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Row="6" Grid.Column="2" VerticalAlignment="Center"
                       Text="{Binding ElementName=FuelOpacity, Path=Value, StringFormat={}{0:P0}}" />
            <Slider x:Name="FuelScale" Grid.Row="6" Grid.Column="3"
                    Minimum="0.5" Maximum="2" TickFrequency="0.05"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Row="6" Grid.Column="4" VerticalAlignment="Center"
                       Text="{Binding ElementName=FuelScale, Path=Value, StringFormat={}{0:0.00}x}" />

            <CheckBox x:Name="RaceControlVisible" Grid.Row="7" Grid.Column="0"
                      Content="Race Control / Damage" VerticalAlignment="Center" />
            <Slider x:Name="RaceControlOpacity" Grid.Row="7" Grid.Column="1"
                    Minimum="0.2" Maximum="1" TickFrequency="0.05"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Row="7" Grid.Column="2" VerticalAlignment="Center"
                       Text="{Binding ElementName=RaceControlOpacity, Path=Value, StringFormat={}{0:P0}}" />
            <Slider x:Name="RaceControlScale" Grid.Row="7" Grid.Column="3"
                    Minimum="0.5" Maximum="2" TickFrequency="0.05"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Row="7" Grid.Column="4" VerticalAlignment="Center"
                       Text="{Binding ElementName=RaceControlScale, Path=Value, StringFormat={}{0:0.00}x}" />

            <CheckBox x:Name="PriorityAlerts" Grid.Row="8" Grid.Column="0"
                      Content="Alerta superior" VerticalAlignment="Center" />
            <Slider x:Name="PriorityAlertOpacity" Grid.Row="8" Grid.Column="1"
                    Minimum="0.2" Maximum="1" TickFrequency="0.05"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Row="8" Grid.Column="2" VerticalAlignment="Center"
                       Text="{Binding ElementName=PriorityAlertOpacity, Path=Value, StringFormat={}{0:P0}}" />
            <Slider x:Name="PriorityAlertScale" Grid.Row="8" Grid.Column="3"
                    Minimum="0.5" Maximum="2" TickFrequency="0.05"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Row="8" Grid.Column="4" VerticalAlignment="Center"
                       Text="{Binding ElementName=PriorityAlertScale, Path=Value, StringFormat={}{0:0.00}x}" />
        </Grid>
        <Border Grid.Row="4" Margin="0,18,0,0" Padding="12"
                Background="#FF111923" BorderBrush="#FF263645" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.ColumnSpan="4" Text="PERFIL, ESTRATÉGIA E DESEMPENHO"
                           Foreground="#FF788795" FontWeight="Bold" FontSize="10"
                           Margin="0,0,0,9" />
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Tema" Foreground="#FF9BA8B5" FontSize="10" />
                    <ComboBox x:Name="ThemeSelector" Height="28">
                        <ComboBoxItem Content="RedFox" Tag="RedFox" />
                        <ComboBoxItem Content="Preto" Tag="Black" />
                        <ComboBoxItem Content="Alto contraste" Tag="HighContrast" />
                        <ComboBoxItem Content="Visão de cores segura" Tag="ColorVisionSafe" />
                        <ComboBoxItem Content="Personalizado" Tag="Custom" />
                    </ComboBox>
                    <TextBlock Text="Idioma / Language" Foreground="#FF9BA8B5" FontSize="10" Margin="0,7,0,0" />
                    <ComboBox x:Name="LanguageSelector" Height="28" SelectionChanged="LanguageSelector_OnSelectionChanged">
                        <ComboBoxItem Content="Português (Brasil)" Tag="pt-BR" />
                        <ComboBoxItem Content="English" Tag="en-US" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Atualização (Hz)" Foreground="#FF9BA8B5" FontSize="10" />
                    <Slider x:Name="RefreshRate" Minimum="30" Maximum="144"
                            TickFrequency="1" IsSnapToTickEnabled="True" />
                    <TextBlock Text="{Binding ElementName=RefreshRate, Path=Value, StringFormat={}{0:0} Hz}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Grade magnética (px)" Foreground="#FF9BA8B5" FontSize="10" />
                    <Slider x:Name="GridSnap" Minimum="0" Maximum="50"
                            TickFrequency="5" IsSnapToTickEnabled="True" />
                    <TextBlock Text="{Binding ElementName=GridSnap, Path=Value, StringFormat={}{0:0} px}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3">
                    <TextBlock Text="Reserva combustível (voltas)" Foreground="#FF9BA8B5" FontSize="10" />
                    <Slider x:Name="FuelReserve" Minimum="0" Maximum="5"
                            TickFrequency="0.25" IsSnapToTickEnabled="True" />
                    <TextBlock Text="{Binding ElementName=FuelReserve, Path=Value, StringFormat={}{0:0.00}}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,10,12,0">
                    <TextBlock Text="Nome na dashboard" Foreground="#FF9BA8B5" FontSize="10" />
                    <TextBox x:Name="DashboardTitle" Height="27" MaxLength="24" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,10,12,0">
                    <TextBlock Text="Cor principal personalizada" Foreground="#FF9BA8B5" FontSize="10" />
                    <TextBox x:Name="CustomAccentColor" Height="27" TextChanged="CustomColorChanged" ToolTip="Formato hexadecimal, por exemplo #42D3A6" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,10,12,0">
                    <TextBlock Text="Cor de fundo personalizada" Foreground="#FF9BA8B5" FontSize="10" />
                    <TextBox x:Name="CustomBackgroundColor" Height="27" TextChanged="CustomColorChanged" ToolTip="Formato hexadecimal, por exemplo #0A0F1A" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="3" Margin="0,10,0,0">
                    <TextBlock Text="Cor dos cartões" Foreground="#FF9BA8B5" FontSize="10" />
                    <TextBox x:Name="CustomCardColor" Height="27" TextChanged="CustomColorChanged" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,10,12,0">
                    <TextBlock Text="Reserva VE (%)" Foreground="#FF9BA8B5" FontSize="10" />
                    <TextBox x:Name="EnergyReserve" Height="27" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,10,12,0">
                    <TextBlock Text="Voltas restantes (0 = auto)" Foreground="#FF9BA8B5" FontSize="10" />
                    <TextBox x:Name="ManualRemainingLaps" Height="27" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,10,12,0">
                    <TextBlock Text="Máx. stint (0 = auto)" Foreground="#FF9BA8B5" FontSize="10" />
                    <TextBox x:Name="MaximumStintLaps" Height="27" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="3" Margin="0,10,0,0">
                    <TextBlock Text="Perda por pit (s)" Foreground="#FF9BA8B5" FontSize="10" />
                    <TextBox x:Name="PitLossSeconds" Height="27" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,10,12,0">
                    <TextBlock Text="Jogos de pneus (0 = livre)" Foreground="#FF9BA8B5" FontSize="10" />
                    <TextBox x:Name="AvailableTireSets" Height="27" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,10,12,0">
                    <TextBlock Text="Limite de desgaste (%)" Foreground="#FF9BA8B5" FontSize="10" />
                    <TextBox x:Name="TireWearLimit" Height="27" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,10,12,0">
                    <TextBlock Text="Troca de pneus (s)" Foreground="#FF9BA8B5" FontSize="10" />
                    <TextBox x:Name="TireChangeSeconds" Height="27" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="3" Margin="0,10,0,0">
                    <TextBlock Text="Dura&#231;&#227;o restante manual (min)" Foreground="#FF9BA8B5" FontSize="10" />
                    <TextBox x:Name="ManualRemainingMinutes" Height="27" />
                </StackPanel>
                <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,10,12,0">
                    <TextBlock Text="Volta manual (s)" Foreground="#FF9BA8B5" FontSize="10" />
                    <TextBox x:Name="ManualLapTimeSeconds" Height="27" />
                </StackPanel>
                <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,10,12,0">
                    <TextBlock Text="Consumo manual (L/volta)" Foreground="#FF9BA8B5" FontSize="10" />
                    <TextBox x:Name="ManualFuelPerLapLiters" Height="27" />
                </StackPanel>
                <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,10,12,0">
                    <TextBlock Text="Tanque manual (L)" Foreground="#FF9BA8B5" FontSize="10" />
                    <TextBox x:Name="ManualFuelCapacityLiters" Height="27" />
                </StackPanel>
                <TextBlock Grid.Row="5" Grid.Column="3" Margin="0,10,0,0"
                           Text="Valores 0 mant&#233;m o c&#225;lculo autom&#225;tico. Voltas manuais t&#234;m prioridade sobre a dura&#231;&#227;o."
                           Foreground="#FF718096" FontSize="9" TextWrapping="Wrap" />
                <StackPanel Grid.Row="6" Grid.Column="0" Margin="0,10,12,0">
                    <TextBlock Text="Opacidade global do fundo" Foreground="#FF9BA8B5" FontSize="10" />
                    <Slider x:Name="BackgroundOpacity" Minimum="0.35" Maximum="1"
                            TickFrequency="0.05" IsSnapToTickEnabled="True" />
                    <TextBlock Text="{Binding ElementName=BackgroundOpacity, Path=Value, StringFormat={}{0:P0}}" />
                </StackPanel>
                <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,10,12,0">
                    <TextBlock Text="Densidade visual" Foreground="#FF9BA8B5" FontSize="10" />
                    <ComboBox x:Name="DensitySelector" Height="27">
                        <ComboBoxItem Content="Automática" Tag="Auto" />
                        <ComboBoxItem Content="Compacta" Tag="Compact" />
                        <ComboBoxItem Content="Normal" Tag="Normal" />
                        <ComboBoxItem Content="Expandida" Tag="Expanded" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="6" Grid.Column="2" Margin="0,10,12,0">
                    <TextBlock Text="Histórico dos pedais (s)" Foreground="#FF9BA8B5" FontSize="10" />
                    <Slider x:Name="PedalHistory" Minimum="3" Maximum="10"
                            TickFrequency="1" IsSnapToTickEnabled="True" />
                    <TextBlock Text="{Binding ElementName=PedalHistory, Path=Value, StringFormat={}{0:0} s}" />
                </StackPanel>
                <StackPanel Grid.Row="6" Grid.Column="3" Margin="0,10,0,0">
                    <CheckBox x:Name="ReduceMotion" Content="Reduzir movimento" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="7" Grid.Column="0" Margin="0,10,12,0">
                    <TextBlock Text="Texto da dashboard" Foreground="#FF9BA8B5" FontSize="10" />
                    <Slider x:Name="DashboardTextScale" Minimum="0.8" Maximum="1.25"
                            TickFrequency="0.05" IsSnapToTickEnabled="True" />
                    <TextBlock Text="{Binding ElementName=DashboardTextScale, Path=Value, StringFormat={}{0:0.00}x}" />
                </StackPanel>
                <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,10,12,0">
                    <TextBlock Text="Texto das torres" Foreground="#FF9BA8B5" FontSize="10" />
                    <Slider x:Name="TimingTextScale" Minimum="0.8" Maximum="1.25"
                            TickFrequency="0.05" IsSnapToTickEnabled="True" />
                    <TextBlock Text="{Binding ElementName=TimingTextScale, Path=Value, StringFormat={}{0:0.00}x}" />
                </StackPanel>
                <StackPanel Grid.Row="7" Grid.Column="2" Margin="0,10,12,0">
                    <TextBlock Text="Texto dos inputs" Foreground="#FF9BA8B5" FontSize="10" />
                    <Slider x:Name="InputsTextScale" Minimum="0.8" Maximum="1.25"
                            TickFrequency="0.05" IsSnapToTickEnabled="True" />
                    <TextBlock Text="{Binding ElementName=InputsTextScale, Path=Value, StringFormat={}{0:0.00}x}" />
                </StackPanel>
                <StackPanel Grid.Row="7" Grid.Column="3" Margin="0,10,0,0">
                    <TextBlock Text="Máx. carros no Live Standings" Foreground="#FF9BA8B5" FontSize="10" />
                    <Slider x:Name="LiveStandingsMaximumRows" Minimum="6" Maximum="12"
                            TickFrequency="1" IsSnapToTickEnabled="True" />
                    <TextBlock Text="{Binding ElementName=LiveStandingsMaximumRows, Path=Value, StringFormat={}{0:0} carros}" />
                </StackPanel>
                <StackPanel Grid.Row="8" Grid.Column="0" Margin="0,10,12,0">
                    <TextBlock Text="Carros de cada lado no Relative" Foreground="#FF9BA8B5" FontSize="10" />
                    <Slider x:Name="RelativeCarsEachSide" Minimum="2" Maximum="5"
                            TickFrequency="1" IsSnapToTickEnabled="True" />
                    <TextBlock Text="{Binding ElementName=RelativeCarsEachSide, Path=Value, StringFormat={}{0:0} por lado}" />
                </StackPanel>
                <TextBlock Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,10,0,0"
                           Text="As escalas internas alteram a legibilidade sem mudar a posição nem o tamanho externo de cada overlay."
                           Foreground="#FF718096" FontSize="9" TextWrapping="Wrap" />
                <StackPanel Grid.Row="9" Grid.Column="0" Margin="0,10,12,0">
                    <TextBlock Text="Texto principal" Foreground="#FF9BA8B5" FontSize="10" />
                    <TextBox x:Name="CustomPrimaryTextColor" Height="27" TextChanged="CustomColorChanged" />
                </StackPanel>
                <StackPanel Grid.Row="9" Grid.Column="1" Margin="0,10,12,0">
                    <TextBlock Text="Texto secundário" Foreground="#FF9BA8B5" FontSize="10" />
                    <TextBox x:Name="CustomSecondaryTextColor" Height="27" TextChanged="CustomColorChanged" />
                </StackPanel>
                <StackPanel Grid.Row="9" Grid.Column="2" Margin="0,10,12,0">
                    <TextBlock Text="Informação" Foreground="#FF9BA8B5" FontSize="10" />
                    <TextBox x:Name="CustomInformationColor" Height="27" TextChanged="CustomColorChanged" />
                </StackPanel>
                <StackPanel Grid.Row="9" Grid.Column="3" Margin="0,10,0,0">
                    <TextBlock Text="Atenção" Foreground="#FF9BA8B5" FontSize="10" />
                    <TextBox x:Name="CustomAttentionColor" Height="27" TextChanged="CustomColorChanged" />
                </StackPanel>
                <StackPanel Grid.Row="10" Grid.Column="0" Margin="0,10,12,0">
                    <TextBlock Text="Crítico" Foreground="#FF9BA8B5" FontSize="10" />
                    <TextBox x:Name="CustomCriticalColor" Height="27" TextChanged="CustomColorChanged" />
                </StackPanel>
                <StackPanel Grid.Row="10" Grid.Column="1" Margin="0,10,12,0">
                    <TextBlock Text="Positivo" Foreground="#FF9BA8B5" FontSize="10" />
                    <TextBox x:Name="CustomPositiveColor" Height="27" TextChanged="CustomColorChanged" />
                </StackPanel>
                <StackPanel Grid.Row="10" Grid.Column="2" Margin="0,10,12,0">
                    <TextBlock Text="Módulos da dashboard" Foreground="#FF9BA8B5" FontSize="10" />
                    <CheckBox x:Name="DashboardShowSectors" Content="Setores" />
                    <CheckBox x:Name="DashboardShowTires" Content="Pneus" />
                    <CheckBox x:Name="DashboardShowTelemetry" Content="Telemetria" />
                </StackPanel>
                <TextBlock Grid.Row="10" Grid.Column="3" Margin="0,10,0,0"
                           Text="Editar qualquer cor ativa automaticamente o tema Personalizado. Os módulos escolhidos são aplicados no Desktop e no VR."
                           Foreground="#FF718096" FontSize="9" TextWrapping="Wrap" />
                <StackPanel Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="4"
                            Margin="0,12,0,0" Orientation="Horizontal">
                    <TextBlock Text="INTEGRAÇÕES" Foreground="#FF9BA8B5"
                               FontSize="10" FontWeight="Bold" Margin="0,0,14,0"
                               VerticalAlignment="Center" />
                    <CheckBox x:Name="EnableOfficialTimingHttp"
                              Content="Optimal oficial via HTTP local"
                              Margin="0,0,18,0" VerticalAlignment="Center" />
                    <CheckBox x:Name="EnableNativeRendering"
                              Content="Renderização DirectX"
                              Margin="0,0,18,0" VerticalAlignment="Center" />
                    <CheckBox x:Name="EnableSteamVr"
                              Content="SteamVR" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="4"
                            Margin="0,12,0,0" Orientation="Horizontal">
                    <TextBlock Text="ORDEM DOS MÓDULOS" Foreground="#FF9BA8B5"
                               FontSize="10" FontWeight="Bold" Margin="0,0,14,0"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="DashboardModule1" Width="125" Margin="0,0,8,0">
                        <ComboBoxItem Content="Setores" Tag="Sectors" />
                        <ComboBoxItem Content="Pneus" Tag="Tires" />
                        <ComboBoxItem Content="Telemetria" Tag="Telemetry" />
                    </ComboBox>
                    <ComboBox x:Name="DashboardModule2" Width="125" Margin="0,0,8,0">
                        <ComboBoxItem Content="Setores" Tag="Sectors" />
                        <ComboBoxItem Content="Pneus" Tag="Tires" />
                        <ComboBoxItem Content="Telemetria" Tag="Telemetry" />
                    </ComboBox>
                    <ComboBox x:Name="DashboardModule3" Width="125">
                        <ComboBoxItem Content="Setores" Tag="Sectors" />
                        <ComboBoxItem Content="Pneus" Tag="Tires" />
                        <ComboBoxItem Content="Telemetria" Tag="Telemetry" />
                    </ComboBox>
                </StackPanel>
                <Grid Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ÍCONE DO VOLANTE"
                               Foreground="#FF9BA8B5" FontSize="10" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,14,0" />
                    <TextBox x:Name="SteeringWheelImagePath" Grid.Column="1"
                             Height="28" IsReadOnly="True" VerticalContentAlignment="Center"
                             ToolTip="PNG transparente, 256–2048 px, até 5 MB. Vazio usa o volante RedFox padrão." />
                    <Button Grid.Column="2" Content="Escolher PNG"
                            Click="ChooseSteeringWheelImageClicked"
                            Padding="12,6" Margin="8,0,6,0" />
                    <Button Grid.Column="3" Content="Usar padrão"
                            Click="ResetSteeringWheelImageClicked" Padding="12,6" />
                </Grid>
                <StackPanel Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="4"
                            Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock Text="ROTAÇÃO DO VOLANTE"
                               Foreground="#FF9BA8B5" FontSize="10" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,14,0" />
                    <TextBox x:Name="SteeringWheelRangeDegrees" Width="90" Height="28"
                             VerticalContentAlignment="Center" TextAlignment="Right"
                             ToolTip="Range total em graus. Use 0 para detectar pelo carro no LMU." />
                    <TextBlock x:Name="SteeringDevicesText"
                               Text="°  (0 = automático; ajuste somente se o carro publicar o range errado)"
                               Foreground="#FF718096" FontSize="9" VerticalAlignment="Center"
                               Margin="6,0,0,0" />
                </StackPanel>
                <Grid Grid.Row="15" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.7*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <CheckBox x:Name="UseDirectSteeringInput"
                                  Content="Ler volante físico pelo Windows" />
                        <StackPanel Orientation="Horizontal" Margin="22,5,0,0">
                            <TextBlock Text="ID do dispositivo" Foreground="#FF9BA8B5"
                                       FontSize="9" VerticalAlignment="Center" />
                            <TextBox x:Name="SteeringInputDeviceId" Width="48" Height="25"
                                     Margin="8,0,0,0" TextAlignment="Right"
                                     ToolTip="-1 seleciona automaticamente um volante reconhecido." />
                            <TextBlock Text="(-1 = auto)" Foreground="#FF718096"
                                       FontSize="9" Margin="5,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <CheckBox x:Name="AllowMultiMonitorPlacement"
                                  Content="Permitir outros monitores" />
                        <TextBlock Text="O editor passa a usar todo o desktop virtual."
                                   Foreground="#FF718096" FontSize="9" Margin="22,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="EnableRemoteDashboard"
                                      Content="Dashboard no celular" />
                            <TextBlock Text="Porta" Foreground="#FF9BA8B5" FontSize="9"
                                       Margin="14,0,5,0" VerticalAlignment="Center" />
                            <TextBox x:Name="RemoteDashboardPort" Width="60" Height="25"
                                     TextAlignment="Right" />
                        </StackPanel>
                        <TextBlock x:Name="RemoteDashboardAddress" Foreground="#FF42D3A6"
                                   FontSize="9" Margin="22,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <DockPanel Grid.Row="5" Margin="0,20,0,0">
            <Button Content="Restaurar perfil"
                    Click="ResetClicked"
                    Padding="14,8"
                    Background="#FF202A33"
                    Foreground="White"
                    BorderBrush="#FF394957" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Fechar"
                        Click="CloseClicked"
                        Padding="18,8"
                        Margin="0,0,8,0"
                        Background="#FF202A33"
                        Foreground="White"
                        BorderBrush="#FF394957" />
                <Button Content="Aplicar"
                        Click="ApplyClicked"
                        Padding="18,8"
                        Background="#FF15765F"
                        Foreground="White"
                        BorderBrush="#FF42D3A6"
                        FontWeight="Bold" />
            </StackPanel>
        </DockPanel>
    </Grid>
    </ScrollViewer>
</Window>
