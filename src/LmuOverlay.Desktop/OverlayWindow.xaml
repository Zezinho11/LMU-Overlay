<Window x:Class="LmuOverlay.Desktop.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="LMU Overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">
    <Canvas x:Name="OverlayCanvas" Background="Transparent">
        <Border x:Name="DiagnosticWidget"
                MinWidth="170"
                MinHeight="100"
                Padding="12"
                CornerRadius="8"
                Background="#DD101820"
                BorderBrush="#FF42D3A6"
                BorderThickness="1"
                MouseLeftButtonDown="WidgetMouseLeftButtonDown"
                MouseMove="WidgetMouseMove"
                MouseLeftButtonUp="WidgetMouseLeftButtonUp">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="LMU LIVE" Foreground="#FF42D3A6"
                               FontWeight="Bold" FontSize="12" />
                    <TextBlock x:Name="ConnectionText" DockPanel.Dock="Right"
                               Text="AGUARDANDO" Foreground="#FFAAB7C4"
                               FontSize="10" HorizontalAlignment="Right" />
                </DockPanel>
                <StackPanel Grid.Row="1" Margin="0,8,0,4">
                    <TextBlock x:Name="SpeedText" Text="--- km/h"
                               Foreground="White" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock x:Name="DetailText" Text="Abra o Le Mans Ultimate"
                               Foreground="#FFD2D9E0" FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="InputsText" Text="THR 0%  BRK 0%  STR 0%"
                               Foreground="#FF9FE8D1" FontSize="11"
                               Margin="0,4,0,0" />
                </StackPanel>
                <TextBlock x:Name="EditHint" Grid.Row="2"
                           Text="ARRASTE • REDIMENSIONE PELO CANTO"
                           Foreground="#FFFFCA6A" FontSize="9"
                           Visibility="Collapsed" />
                <primitives:Thumb x:Name="ResizeThumb" Grid.RowSpan="3"
                                  Width="18" Height="18"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Cursor="SizeNWSE"
                                  Background="#FFFFCA6A"
                                  Visibility="Collapsed"
                                  DragDelta="ResizeThumbDragDelta"
                                  DragCompleted="ResizeThumbDragCompleted" />
            </Grid>
        </Border>
    </Canvas>
</Window>
