<Window x:Class="LmuOverlay.Desktop.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="LMU Overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Typography.NumeralAlignment="Tabular"
        Typography.NumeralStyle="Lining"
        RenderOptions.BitmapScalingMode="HighQuality"
        Topmost="True">
    <Canvas x:Name="OverlayCanvas" Background="Transparent">
        <Border x:Name="DiagnosticWidget"
                Padding="6"
                ClipToBounds="True"
                CornerRadius="15"
                Background="#FF020304"
                BorderBrush="#FF272D31"
                BorderThickness="3"
                MouseLeftButtonDown="WidgetMouseLeftButtonDown"
                MouseMove="WidgetMouseMove"
                MouseLeftButtonUp="WidgetMouseLeftButtonUp">
            <Grid>
                <Viewbox Stretch="Uniform" StretchDirection="Both">
                    <Grid x:Name="DashboardRoot" Width="800" Height="480" TextElement.FontFamily="Bahnschrift"
                          TextElement.FontSize="12"
                          Background="#FF030506">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="38" />
                    <RowDefinition Height="205" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.RowSpan="4" Orientation="Vertical"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="3,0,0,0" Panel.ZIndex="3">
                    <Ellipse Width="9" Height="9" Margin="0,4" Fill="#FF334DFF" />
                    <Ellipse Width="9" Height="9" Margin="0,4" Fill="#FF334DFF" />
                    <Ellipse Width="9" Height="9" Margin="0,4" Fill="#FF334DFF" />
                    <Ellipse Width="9" Height="9" Margin="0,4" Fill="#FF334DFF" />
                    <Ellipse Width="9" Height="9" Margin="0,4" Fill="#FF334DFF" />
                </StackPanel>
                <StackPanel Grid.RowSpan="4" Orientation="Vertical"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,3,0" Panel.ZIndex="3">
                    <Ellipse Width="9" Height="9" Margin="0,4" Fill="#FF334DFF" />
                    <Ellipse Width="9" Height="9" Margin="0,4" Fill="#FF334DFF" />
                    <Ellipse Width="9" Height="9" Margin="0,4" Fill="#FF334DFF" />
                    <Ellipse Width="9" Height="9" Margin="0,4" Fill="#FF334DFF" />
                    <Ellipse Width="9" Height="9" Margin="0,4" Fill="#FF334DFF" />
                </StackPanel>
                <StackPanel Grid.Row="0" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,4,0,5">
                    <Ellipse x:Name="ShiftLight01" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight02" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight03" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight04" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight05" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight06" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight07" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight08" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight09" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight10" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight11" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight12" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="24,0,24,6">
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="TrackText" Text="LMU"
                                   Foreground="White" FontSize="12" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="EnvironmentText" Text="TRACK --  AIR --  RAIN --%"
                                    Foreground="#FF97A4B2" FontSize="10" />
                    </StackPanel>
                    <TextBlock x:Name="DashboardBrandText" Text="REDFOX RACING" Foreground="White"
                               FontWeight="Bold" FontSize="28"
                               HorizontalAlignment="Center" />
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                            BorderBrush="#FF32B9A7" BorderThickness="1"
                            Padding="8,3" CornerRadius="2">
                        <TextBlock x:Name="ConnectionText" Text="AGUARDANDO"
                                   Foreground="#FF61D9C9" FontSize="9" />
                    </Border>
                </Grid>
                <Grid Grid.Row="2" Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.1*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Margin="3" Padding="9"
                            Background="#FF121617"
                            BorderBrush="#FF343A3D" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="PositionText" Text="POS --"
                                   Foreground="#FF42D3A6" FontWeight="Bold" FontSize="17" />
                        <TextBlock x:Name="LapText" Text="LAP --"
                                   Foreground="White" FontSize="15" Margin="0,3,0,0" />
                        <TextBlock x:Name="DeltaText" Text="DELTA --"
                                   Foreground="#FFFFCA6A" FontWeight="Bold"
                                   FontSize="15" Margin="0,6,0,0" />
                        <TextBlock x:Name="FuelText" Text="FUEL --.- L"
                                   Foreground="#FFD2D9E0" FontSize="13" Margin="0,4,0,0" />
                        <TextBlock x:Name="VirtualEnergyDashText" Text="VIRTUAL ENERGY --%"
                                   Foreground="#FFDA40E8" FontSize="13" Margin="0,2,0,0" />
                        <TextBlock x:Name="BrakeBiasText" Text="BRAKE BIAS --.-%"
                                   Foreground="#FFD2D9E0" FontSize="13" Margin="0,2,0,0" />
                        <TextBlock x:Name="SessionModeText" Text="SESSION --"
                                   Foreground="#FF42D3A6" FontSize="13" FontWeight="Bold"
                                   Margin="0,8,0,0" />
                        <TextBlock x:Name="SessionTimeText" Text="--:--:--"
                                   Foreground="White" FontSize="14" />
                        <TextBlock x:Name="PenaltyDashText" Text="PENALTY CLEAR"
                                   Foreground="#FF42D3A6" FontSize="12" FontWeight="Bold"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Margin="5,3" Padding="8,3"
                            Background="#FF0B0E0F"
                            BorderBrush="#FF3C4246" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="SpeedText" Text="--- KM/H"
                                   Foreground="#FFE1E5E7" FontSize="24"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <Border x:Name="PitLimiterIndicator"
                                Visibility="Collapsed"
                                Background="#FFFF8728"
                                BorderBrush="#FFFFC247"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="10,2"
                                Margin="0,2,0,0"
                                HorizontalAlignment="Center">
                            <TextBlock Text="PIT LIMITER"
                                       Foreground="#FF07090A"
                                       FontSize="11"
                                       FontWeight="Bold" />
                        </Border>
                        <TextBlock x:Name="GearText" Text="N"
                                   Foreground="White" FontSize="92" FontWeight="Bold"
                                   LineHeight="70" HorizontalAlignment="Center" />
                        <TextBlock x:Name="RpmText" Text="RPM ----"
                                   Foreground="#FFD2D9E0" FontSize="14"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Margin="3" Padding="9"
                            Background="#FF121617"
                            BorderBrush="#FF343A3D" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="CurrentLapText" Text="CURRENT --:--.---"
                                   Foreground="White" FontSize="14" />
                        <TextBlock x:Name="LastLapText" Text="LAST --:--.---"
                                   Foreground="#FFD2D9E0" FontSize="13" Margin="0,3,0,0" />
                        <TextBlock x:Name="BestLapText" Text="BEST --:--.---"
                                   Foreground="#FF42D3A6" FontSize="13" Margin="0,2,0,0" />
                        <TextBlock x:Name="OptimalLapText" Text="OPTIMAL --:--.---"
                                   Foreground="#FF12D9E5" FontSize="13" Margin="0,2,0,0" />
                        <primitives:UniformGrid Columns="4" Margin="0,4,0,0">
                            <Border x:Name="TcIndicator" Padding="5,4" CornerRadius="3"
                                    Background="#FF202A33" Margin="0,0,3,0">
                                <StackPanel>
                                    <TextBlock x:Name="TcIndicatorText" Text="TC"
                                               Foreground="#FF788795" FontWeight="Bold"
                                                FontSize="10" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TcLevelText" Text="--"
                                               Foreground="White" FontWeight="Bold"
                                                FontSize="18" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Padding="5,4" CornerRadius="3"
                                    Background="#FF202A33" Margin="0,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="SLIP" Foreground="#FF788795"
                                               FontWeight="Bold" FontSize="10"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TcSlipLevelText" Text="--"
                                               Foreground="White" FontWeight="Bold"
                                                FontSize="18" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Padding="5,4" CornerRadius="3"
                                    Background="#FF202A33" Margin="0,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="CUT" Foreground="#FF788795"
                                               FontWeight="Bold" FontSize="10"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TcCutLevelText" Text="--"
                                               Foreground="White" FontWeight="Bold"
                                                FontSize="18" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="AbsIndicator" Padding="5,4" CornerRadius="3"
                                    Background="#FF202A33">
                                <StackPanel>
                                    <TextBlock x:Name="AbsIndicatorText" Text="ABS"
                                               Foreground="#FF788795" FontWeight="Bold"
                                                FontSize="10" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="AbsLevelText" Text="--"
                                               Foreground="White" FontWeight="Bold"
                                                FontSize="18" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </primitives:UniformGrid>
                        <TextBlock x:Name="EngineTempsText" Text="OIL --°  WATER --°"
                                   Foreground="#FFD2D9E0" FontSize="12" Margin="0,6,0,0" />
                    </StackPanel>
                    </Border>
                </Grid>
                <Grid Grid.Row="3" Margin="24,7,24,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SectorColumn" Width="214" />
                        <ColumnDefinition x:Name="TireColumn" Width="270" />
                        <ColumnDefinition x:Name="TelemetryColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="SectorPanel" Grid.Column="0" Margin="3" Background="#FF0B0E0F"
                            BorderBrush="#FF3C4246" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="#FF12D9E5">
                                <TextBlock Text="SECTORS" Foreground="#FF031013"
                                           FontSize="15" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Grid Grid.Row="1" Margin="8,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="LAST" Foreground="#FF7F8C99" FontSize="8" />
                                    <TextBlock x:Name="SectorLastLapText" Text="--:--.---"
                                                Foreground="White" FontSize="16" FontWeight="Bold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="BEST" Foreground="#FF7F8C99" FontSize="8" />
                                    <TextBlock x:Name="SectorBestLapText" Text="--:--.---"
                                                Foreground="#FFB84BDF" FontSize="16" FontWeight="Bold" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="2" Margin="8,1,8,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="S1" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="S2" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Text="S3" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock x:Name="Sector1Text" Grid.Row="0" Grid.Column="1" Text="--.---" Foreground="White" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock x:Name="Sector2Text" Grid.Row="1" Grid.Column="1" Text="--.---" Foreground="White" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock x:Name="Sector3Text" Grid.Row="2" Grid.Column="1" Text="--.---" Foreground="White" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock x:Name="Sector1DeltaText" Grid.Row="0" Grid.Column="2" Text="--.---" Foreground="#FFC14CFF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock x:Name="Sector2DeltaText" Grid.Row="1" Grid.Column="2" Text="--.---" Foreground="#FFC14CFF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock x:Name="Sector3DeltaText" Grid.Row="2" Grid.Column="2" Text="--.---" Foreground="#FFC14CFF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                    <Border x:Name="TirePanel" Grid.Column="1" Margin="3" Background="#FF15191B"
                            BorderBrush="#FFE1972F" BorderThickness="1">
                        <Grid>
                            <Border Height="25" VerticalAlignment="Top"
                                    Margin="0" Panel.ZIndex="2"
                                    Background="#FFD78421">
                                <TextBlock Text="TYRE TEMP / WEAR" Foreground="White"
                                           FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Grid Margin="10,31,10,25">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="FL" Foreground="White" FontSize="12"
                                               FontWeight="Bold" Width="22" />
                                    <Grid Width="15" Height="24">
                                        <Border x:Name="FrontLeftTireIcon"
                                                CornerRadius="4"
                                                Background="#FF485460" />
                                        <Rectangle Height="2" Margin="3,0"
                                                   Fill="#99070B0D"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="FrontLeftTireText"
                                               Text="FL --° · D --%" Foreground="#FFE7EAEC"
                                               FontSize="14" FontWeight="SemiBold"
                                               Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="FR" Foreground="White" FontSize="12"
                                               FontWeight="Bold" Width="22" />
                                    <Grid Width="15" Height="24">
                                        <Border x:Name="FrontRightTireIcon"
                                                CornerRadius="4"
                                                Background="#FF485460" />
                                        <Rectangle Height="2" Margin="3,0"
                                                   Fill="#99070B0D"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="FrontRightTireText"
                                               Text="FR --° · D --%" Foreground="#FFE7EAEC"
                                               FontSize="14" FontWeight="SemiBold"
                                               Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="RL" Foreground="White" FontSize="12"
                                               FontWeight="Bold" Width="22" />
                                    <Grid Width="15" Height="24">
                                        <Border x:Name="RearLeftTireIcon"
                                                CornerRadius="4"
                                                Background="#FF485460" />
                                        <Rectangle Height="2" Margin="3,0"
                                                   Fill="#99070B0D"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="RearLeftTireText"
                                               Text="RL --° · D --%" Foreground="#FFE7EAEC"
                                               FontSize="14" FontWeight="SemiBold"
                                               Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="RR" Foreground="White" FontSize="12"
                                               FontWeight="Bold" Width="22" />
                                    <Grid Width="15" Height="24">
                                        <Border x:Name="RearRightTireIcon"
                                                CornerRadius="4"
                                                Background="#FF485460" />
                                        <Rectangle Height="2" Margin="3,0"
                                                   Fill="#99070B0D"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="RearRightTireText"
                                               Text="RR --° · D --%" Foreground="#FFE7EAEC"
                                               FontSize="14" FontWeight="SemiBold"
                                               Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="TireCompoundText"
                                       Text="COMPOUND --" Foreground="#FFFFCA6A"
                                       FontSize="12" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom" Margin="0,0,0,7" />
                        </Grid>
                    </Border>
                    <Border x:Name="TelemetryPanel" Grid.Column="2" Margin="3" Background="#FF0B0E0F"
                            BorderBrush="#FF12D9E5" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25" />
                                <RowDefinition Height="32" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="#FF12D9E5">
                                <TextBlock Text="TELEMETRY" Foreground="#FF031013"
                                           FontSize="15" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <UniformGrid Grid.Row="1" Columns="4" Margin="6,2">
                                <StackPanel HorizontalAlignment="Center"><TextBlock Text="THR" Foreground="#FF8D98A4" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="DashboardThrottleText" Text="--" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel HorizontalAlignment="Center"><TextBlock Text="BRK" Foreground="#FF8D98A4" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="DashboardBrakeText" Text="--" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel HorizontalAlignment="Center"><TextBlock Text="GX" Foreground="#FF8D98A4" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="LongitudinalGText" Text="--" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel HorizontalAlignment="Center"><TextBlock Text="GY" Foreground="#FF8D98A4" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="LateralGText" Text="--" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel>
                            </UniformGrid>
                            <Grid Grid.Row="2" Margin="7,2,7,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="66" />
                                </Grid.ColumnDefinitions>
                                <Canvas Width="230" Height="102" HorizontalAlignment="Stretch"
                                        Background="#FF080B0D" ClipToBounds="True">
                                    <Image x:Name="PedalGraphImage"
                                           Width="230" Height="102"
                                           Stretch="None"
                                           SnapsToDevicePixels="True"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Canvas>
                                <Canvas Grid.Column="1" Width="58" Height="102" Background="#FF080B0D">
                                    <Line X1="29" Y1="8" X2="29" Y2="94" Stroke="#FF5B6570" StrokeDashArray="2,4" />
                                    <Line X1="6" Y1="51" X2="52" Y2="51" Stroke="#FF5B6570" StrokeDashArray="2,4" />
                                    <Ellipse x:Name="GForceDot" Width="10" Height="10"
                                             Fill="#FF12D9E5" Canvas.Left="24" Canvas.Top="46" />
                                </Canvas>
                            </Grid>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="EditHint" Grid.Column="2"
                               Panel.ZIndex="5"
                               Text="ARRASTE · REDIMENSIONE"
                               Foreground="#FFFFCA6A" FontSize="9"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Visibility="Collapsed" />
                </Grid>
                    </Grid>
                </Viewbox>
                <primitives:Thumb x:Name="ResizeThumb"
                                  Tag="DiagnosticWidget"
                                  Width="18" Height="18"
                                  Panel.ZIndex="10"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Cursor="SizeNWSE"
                                  Background="#FFFFCA6A"
                                  Visibility="Collapsed"
                                  DragDelta="ResizeThumbDragDelta"
                                  DragCompleted="ResizeThumbDragCompleted" />
            </Grid>
        </Border>
        <Border x:Name="InputsWidget" Padding="10,5" CornerRadius="8"
                Background="#DD101820" BorderBrush="#FF42D3A6" BorderThickness="1"
                MouseLeftButtonDown="WidgetMouseLeftButtonDown"
                MouseMove="WidgetMouseMove"
                MouseLeftButtonUp="WidgetMouseLeftButtonUp">
            <Grid>
                <StackPanel>
                    <TextBlock Text="INPUTS" Foreground="#FF42D3A6" FontWeight="Bold" FontSize="11" />
                    <TextBlock x:Name="InputsText" Text="THR --  BRK --  STR --"
                               Foreground="White" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
                <primitives:Thumb x:Name="InputsResizeThumb" Tag="InputsWidget"
                                  Width="18" Height="18" Panel.ZIndex="10"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Cursor="SizeNWSE" Background="#FFFFCA6A"
                                  Visibility="Collapsed"
                                  DragDelta="ResizeThumbDragDelta"
                                  DragCompleted="ResizeThumbDragCompleted" />
            </Grid>
        </Border>
        <Border x:Name="LiveStandingsWidget" Padding="0" CornerRadius="0" ClipToBounds="True"
                Background="Transparent" BorderThickness="0"
                MouseLeftButtonDown="WidgetMouseLeftButtonDown"
                MouseMove="WidgetMouseMove"
                MouseLeftButtonUp="WidgetMouseLeftButtonUp">
            <Grid>
                <Viewbox Stretch="Uniform" StretchDirection="Both">
                    <Grid Width="500" Height="410" Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Background="#E6121C32" Margin="0">
                            <TextBlock x:Name="StandingsSessionText" Text="SESSION"
                                       Foreground="White" FontFamily="Bahnschrift"
                                       FontWeight="Bold" FontSize="18"
                                       Margin="14,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="StandingsClockText" Text="--:--"
                                       Foreground="White" FontFamily="Bahnschrift"
                                       FontWeight="Bold" FontSize="20"
                                       Margin="14,0" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Grid Grid.Row="1" Background="#FF17213B">
                            <Grid.ColumnDefinitions>
