<Window x:Class="LmuOverlay.Desktop.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="LMU Overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">
    <Canvas x:Name="OverlayCanvas" Background="Transparent">
        <Border x:Name="DiagnosticWidget"
                MinWidth="360"
                MinHeight="220"
                Padding="10"
                CornerRadius="12"
                Background="#FC04070A"
                BorderBrush="#FF42D3A6"
                BorderThickness="1"
                MouseLeftButtonDown="WidgetMouseLeftButtonDown"
                MouseMove="WidgetMouseMove"
                MouseLeftButtonUp="WidgetMouseLeftButtonUp">
            <Grid>
                <Viewbox Stretch="Uniform" StretchDirection="Both">
                    <Grid Width="720" Height="300" TextElement.FontFamily="Bahnschrift">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,0,0,5">
                    <Ellipse x:Name="ShiftLight01" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight02" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight03" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight04" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight05" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight06" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight07" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight08" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight09" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight10" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight11" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight12" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="2,0,2,5">
                    <TextBlock x:Name="TrackText" Text="LMU"
                               Foreground="#FFAAB7C4" FontSize="10"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="REDFOX RACING" Foreground="White"
                               FontWeight="Bold" FontSize="18"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="ConnectionText" Text="AGUARDANDO"
                               Foreground="#FFAAB7C4" FontSize="10"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.1*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="3">
                        <TextBlock x:Name="PositionText" Text="POS --"
                                   Foreground="#FF42D3A6" FontWeight="Bold" FontSize="14" />
                        <TextBlock x:Name="LapText" Text="LAP --"
                                   Foreground="White" FontSize="13" Margin="0,3,0,0" />
                        <TextBlock x:Name="DeltaText" Text="DELTA --"
                                   Foreground="#FFFFCA6A" FontWeight="Bold"
                                   FontSize="13" Margin="0,6,0,0" />
                        <TextBlock x:Name="FuelText" Text="FUEL --.- L"
                                   Foreground="#FFD2D9E0" FontSize="11" Margin="0,4,0,0" />
                        <TextBlock x:Name="BrakeBiasText" Text="BRAKE BIAS --.-%"
                                   Foreground="#FFD2D9E0" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock x:Name="SpeedText" Text="--- KM/H"
                                   Foreground="#FFAAB7C4" FontSize="18"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="GearText" Text="N"
                                   Foreground="White" FontSize="62" FontWeight="Bold"
                                   LineHeight="58" HorizontalAlignment="Center" />
                        <TextBlock x:Name="RpmText" Text="RPM ----"
                                   Foreground="#FFD2D9E0" FontSize="12"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="3">
                        <TextBlock x:Name="CurrentLapText" Text="CURRENT --:--.---"
                                   Foreground="White" FontSize="12" />
                        <TextBlock x:Name="LastLapText" Text="LAST --:--.---"
                                   Foreground="#FFD2D9E0" FontSize="11" Margin="0,3,0,0" />
                        <TextBlock x:Name="BestLapText" Text="BEST --:--.---"
                                   Foreground="#FF42D3A6" FontSize="11" Margin="0,2,0,0" />
                        <primitives:UniformGrid Columns="4" Margin="0,8,0,0">
                            <Border x:Name="TcIndicator" Padding="5,4" CornerRadius="3"
                                    Background="#FF202A33" Margin="0,0,3,0">
                                <StackPanel>
                                    <TextBlock x:Name="TcIndicatorText" Text="TC"
                                               Foreground="#FF788795" FontWeight="Bold"
                                               FontSize="9" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TcLevelText" Text="--"
                                               Foreground="White" FontWeight="Bold"
                                               FontSize="15" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Padding="5,4" CornerRadius="3"
                                    Background="#FF202A33" Margin="0,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="SLIP" Foreground="#FF788795"
                                               FontWeight="Bold" FontSize="9"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TcSlipLevelText" Text="--"
                                               Foreground="White" FontWeight="Bold"
                                               FontSize="15" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Padding="5,4" CornerRadius="3"
                                    Background="#FF202A33" Margin="0,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="CUT" Foreground="#FF788795"
                                               FontWeight="Bold" FontSize="9"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TcCutLevelText" Text="--"
                                               Foreground="White" FontWeight="Bold"
                                               FontSize="15" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="AbsIndicator" Padding="5,4" CornerRadius="3"
                                    Background="#FF202A33">
                                <StackPanel>
                                    <TextBlock x:Name="AbsIndicatorText" Text="ABS"
                                               Foreground="#FF788795" FontWeight="Bold"
                                               FontSize="9" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="AbsLevelText" Text="--"
                                               Foreground="White" FontWeight="Bold"
                                               FontSize="15" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </primitives:UniformGrid>
                        <TextBlock x:Name="EngineTempsText" Text="OIL --°  WATER --°"
                                   Foreground="#FFD2D9E0" FontSize="10" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
                <DockPanel Grid.Row="3" Margin="3,5,3,0">
                    <TextBlock x:Name="TiresText" Text="FL --°  FR --°  RL --°  RR --°"
                               Foreground="#FFD2D9E0" FontSize="11" />
                    <TextBlock x:Name="EditHint" DockPanel.Dock="Right"
                               Text="ARRASTE • REDIMENSIONE PELO CANTO"
                               Foreground="#FFFFCA6A" FontSize="9"
                               Visibility="Collapsed" />
                </DockPanel>
                    </Grid>
                </Viewbox>
                <primitives:Thumb x:Name="ResizeThumb"
                                  Tag="DiagnosticWidget"
                                  Width="18" Height="18"
                                  Panel.ZIndex="10"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Cursor="SizeNWSE"
                                  Background="#FFFFCA6A"
                                  Visibility="Collapsed"
                                  DragDelta="ResizeThumbDragDelta"
                                  DragCompleted="ResizeThumbDragCompleted" />
            </Grid>
        </Border>
        <Border x:Name="InputsWidget" Padding="10" CornerRadius="8"
                Background="#DD101820" BorderBrush="#FF42D3A6" BorderThickness="1"
                MouseLeftButtonDown="WidgetMouseLeftButtonDown"
                MouseMove="WidgetMouseMove"
                MouseLeftButtonUp="WidgetMouseLeftButtonUp">
            <Grid>
                <StackPanel>
                    <TextBlock Text="INPUTS" Foreground="#FF42D3A6" FontWeight="Bold" FontSize="11" />
                    <TextBlock x:Name="InputsText" Text="THR --  BRK --  STR --"
                               Foreground="White" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>
                <primitives:Thumb x:Name="InputsResizeThumb" Tag="InputsWidget"
                                  Width="18" Height="18" Panel.ZIndex="10"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Cursor="SizeNWSE" Background="#FFFFCA6A"
                                  Visibility="Collapsed"
                                  DragDelta="ResizeThumbDragDelta"
                                  DragCompleted="ResizeThumbDragCompleted" />
            </Grid>
        </Border>
        <Border x:Name="LiveStandingsWidget" Padding="0" CornerRadius="7"
                Background="#F2070B18" BorderBrush="#FF21B9E6" BorderThickness="2"
                MouseLeftButtonDown="WidgetMouseLeftButtonDown"
                MouseMove="WidgetMouseMove"
                MouseLeftButtonUp="WidgetMouseLeftButtonUp">
            <Grid>
                <Viewbox Stretch="Uniform">
                    <Grid Width="360" Height="410" Background="#F2070B18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="56" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="16" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#FF080D2B"
                                BorderBrush="#FF21B9E6" BorderThickness="0,0,0,1">
                            <Grid Margin="12,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="REDFOX RACING"
                                               FontFamily="Bahnschrift"
                                               FontWeight="Bold" FontSize="17"
                                               Foreground="White" />
                                    <TextBlock x:Name="StandingsTitleText"
                                               Text="LIVE STANDINGS"
                                               FontFamily="Bahnschrift"
                                               FontWeight="SemiBold" FontSize="11"
                                               Foreground="#FF5AD8FF" />
                                </StackPanel>
                                <TextBlock x:Name="StandingsSubtitleText"
                                           Grid.Column="1"
                                           Text="NO DATA"
                                           VerticalAlignment="Center"
                                           FontFamily="Bahnschrift"
                                           FontSize="10"
                                           Foreground="#FF9BA9B8" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" Background="#FF17213B">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="35" />
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="P" />
                            <TextBlock Grid.Column="1" Text="CAR" />
                            <TextBlock Grid.Column="2" Text="NO." />
                            <TextBlock Grid.Column="3" Text="DRV" />
                            <TextBlock Grid.Column="4" Text="LAST LAP" />
                            <TextBlock Grid.Column="5" Text="INTERVAL"
                                       HorizontalAlignment="Right" Margin="0,0,8,0" />
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="FontFamily" Value="Bahnschrift" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="FontSize" Value="9" />
                                    <Setter Property="Foreground" Value="#FF8292A4" />
                                </Style>
                            </Grid.Resources>
                        </Grid>
                        <StackPanel x:Name="StandingsRows" Grid.Row="2" />
                        <Border Grid.Row="3" Background="#FF007CAB"
                                CornerRadius="0,0,5,5">
                            <TextBlock Text="LE MANS ULTIMATE"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Bahnschrift"
                                       FontWeight="Bold" FontSize="8"
                                       Foreground="White" />
                        </Border>
                    </Grid>
                </Viewbox>
                <primitives:Thumb x:Name="LiveStandingsResizeThumb" Tag="LiveStandingsWidget"
                                  Width="18" Height="18" Panel.ZIndex="10"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Cursor="SizeNWSE" Background="#FFFFCA6A"
                                  Visibility="Collapsed"
                                  DragDelta="ResizeThumbDragDelta"
                                  DragCompleted="ResizeThumbDragCompleted" />
            </Grid>
        </Border>
        <Border x:Name="RelativeWidget" Padding="10" CornerRadius="8"
                Background="#DD101820" BorderBrush="#FF42D3A6" BorderThickness="1"
                MouseLeftButtonDown="WidgetMouseLeftButtonDown"
                MouseMove="WidgetMouseMove"
                MouseLeftButtonUp="WidgetMouseLeftButtonUp">
            <Grid>
                <StackPanel>
                    <TextBlock Text="RELATIVE" Foreground="#FF42D3A6"
                               FontWeight="Bold" FontSize="11" />
                    <StackPanel x:Name="RelativeRows" Margin="0,6,0,0" />
                </StackPanel>
                <primitives:Thumb x:Name="RelativeResizeThumb" Tag="RelativeWidget"
                                  Width="18" Height="18" Panel.ZIndex="10"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Cursor="SizeNWSE" Background="#FFFFCA6A"
                                  Visibility="Collapsed"
                                  DragDelta="ResizeThumbDragDelta"
                                  DragCompleted="ResizeThumbDragCompleted" />
            </Grid>
        </Border>
        <Border x:Name="SessionFlagsWidget" Padding="10" CornerRadius="8"
                Background="#DD101820" BorderBrush="#FF42D3A6" BorderThickness="1"
                MouseLeftButtonDown="WidgetMouseLeftButtonDown"
                MouseMove="WidgetMouseMove"
                MouseLeftButtonUp="WidgetMouseLeftButtonUp">
            <Grid>
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="SessionNameText" Text="SESSION"
                                   Foreground="#FF42D3A6" FontWeight="Bold" FontSize="11" />
                        <TextBlock x:Name="FlagText" Text="NO DATA" DockPanel.Dock="Right"
                                   HorizontalAlignment="Right" Foreground="#FFAAB7C4"
                                   FontWeight="Bold" FontSize="11" />
                    </DockPanel>
                    <TextBlock x:Name="SessionDetailText"
                               Text="--:--  LAP --  AIR --°  TRACK --°"
                               Foreground="White" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>
                <primitives:Thumb x:Name="SessionFlagsResizeThumb" Tag="SessionFlagsWidget"
                                  Width="18" Height="18" Panel.ZIndex="10"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Cursor="SizeNWSE" Background="#FFFFCA6A"
                                  Visibility="Collapsed"
                                  DragDelta="ResizeThumbDragDelta"
                                  DragCompleted="ResizeThumbDragCompleted" />
            </Grid>
        </Border>
        <Border x:Name="FuelStrategyWidget" Padding="10" CornerRadius="8"
                Background="#DD101820" BorderBrush="#FF42D3A6" BorderThickness="1"
                MouseLeftButtonDown="WidgetMouseLeftButtonDown"
                MouseMove="WidgetMouseMove"
                MouseLeftButtonUp="WidgetMouseLeftButtonUp">
            <Grid>
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="FUEL STRATEGY" Foreground="#FF42D3A6"
                                   FontWeight="Bold" FontSize="11" />
                        <TextBlock x:Name="FuelStatusText" Text="LEARNING"
                                   DockPanel.Dock="Right" HorizontalAlignment="Right"
                                   Foreground="#FFFFCA6A" FontWeight="Bold" FontSize="10" />
                    </DockPanel>
                    <TextBlock x:Name="FuelMainText" Text="FUEL --.- L  •  VE --%"
                               Foreground="White" FontSize="15" FontWeight="SemiBold"
                               Margin="0,6,0,0" />
                    <TextBlock x:Name="FuelProjectionText"
                               Text="FUEL --.- L/LAP  •  RANGE --.-"
                               Foreground="#FFD2D9E0" FontSize="11" Margin="0,3,0,0" />
                    <TextBlock x:Name="VirtualEnergyText"
                               Text="VE --.-%/LAP  •  RANGE --.-"
                               Foreground="#FF7DB8FF" FontSize="11" Margin="0,3,0,0" />
                    <TextBlock x:Name="FuelMarginText" Text="NEED --.- L  •  MARGIN --.- L"
                               Foreground="#FFAAB7C4" FontSize="11" FontWeight="Bold"
                               Margin="0,3,0,0" />
                </StackPanel>
                <primitives:Thumb x:Name="FuelStrategyResizeThumb" Tag="FuelStrategyWidget"
                                  Width="18" Height="18" Panel.ZIndex="10"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Cursor="SizeNWSE" Background="#FFFFCA6A"
                                  Visibility="Collapsed"
                                  DragDelta="ResizeThumbDragDelta"
                                  DragCompleted="ResizeThumbDragCompleted" />
            </Grid>
        </Border>
    </Canvas>
</Window>
