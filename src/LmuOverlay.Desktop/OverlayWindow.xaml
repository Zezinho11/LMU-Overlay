<Window x:Class="LmuOverlay.Desktop.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="LMU Overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">
    <Canvas x:Name="OverlayCanvas" Background="Transparent">
        <Border x:Name="DiagnosticWidget"
                MinWidth="360"
                MinHeight="220"
                Padding="6"
                CornerRadius="15"
                Background="#FF020304"
                BorderBrush="#FF272D31"
                BorderThickness="3"
                MouseLeftButtonDown="WidgetMouseLeftButtonDown"
                MouseMove="WidgetMouseMove"
                MouseLeftButtonUp="WidgetMouseLeftButtonUp">
            <Grid>
                <Viewbox Stretch="Uniform" StretchDirection="Both">
                    <Grid Width="720" Height="330" TextElement.FontFamily="Bahnschrift"
                          Background="#FF030506">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.RowSpan="4" Orientation="Vertical"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="3,0,0,0" Panel.ZIndex="3">
                    <Ellipse Width="9" Height="9" Margin="0,4" Fill="#FF334DFF" />
                    <Ellipse Width="9" Height="9" Margin="0,4" Fill="#FF334DFF" />
                    <Ellipse Width="9" Height="9" Margin="0,4" Fill="#FF334DFF" />
                    <Ellipse Width="9" Height="9" Margin="0,4" Fill="#FF334DFF" />
                    <Ellipse Width="9" Height="9" Margin="0,4" Fill="#FF334DFF" />
                </StackPanel>
                <StackPanel Grid.RowSpan="4" Orientation="Vertical"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,3,0" Panel.ZIndex="3">
                    <Ellipse Width="9" Height="9" Margin="0,4" Fill="#FF334DFF" />
                    <Ellipse Width="9" Height="9" Margin="0,4" Fill="#FF334DFF" />
                    <Ellipse Width="9" Height="9" Margin="0,4" Fill="#FF334DFF" />
                    <Ellipse Width="9" Height="9" Margin="0,4" Fill="#FF334DFF" />
                    <Ellipse Width="9" Height="9" Margin="0,4" Fill="#FF334DFF" />
                </StackPanel>
                <StackPanel Grid.Row="0" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,4,0,5">
                    <Ellipse x:Name="ShiftLight01" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight02" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight03" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight04" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight05" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight06" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight07" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight08" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight09" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight10" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight11" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                    <Ellipse x:Name="ShiftLight12" Width="13" Height="13" Margin="2,0" Fill="#FF26313B" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="24,0,24,6">
                    <TextBlock x:Name="TrackText" Text="LMU"
                               Foreground="#FFAAB7C4" FontSize="10"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="REDFOX RACING" Foreground="White"
                               FontWeight="Bold" FontSize="24"
                               HorizontalAlignment="Center" />
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                            BorderBrush="#FF32B9A7" BorderThickness="1"
                            Padding="8,3" CornerRadius="2">
                        <TextBlock x:Name="ConnectionText" Text="AGUARDANDO"
                                   Foreground="#FF61D9C9" FontSize="9" />
                    </Border>
                </Grid>
                <Grid Grid.Row="2" Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.1*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Margin="3" Padding="9"
                            Background="#FF121617"
                            BorderBrush="#FF343A3D" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="PositionText" Text="POS --"
                                   Foreground="#FF42D3A6" FontWeight="Bold" FontSize="14" />
                        <TextBlock x:Name="LapText" Text="LAP --"
                                   Foreground="White" FontSize="13" Margin="0,3,0,0" />
                        <TextBlock x:Name="DeltaText" Text="DELTA --"
                                   Foreground="#FFFFCA6A" FontWeight="Bold"
                                   FontSize="13" Margin="0,6,0,0" />
                        <TextBlock x:Name="FuelText" Text="FUEL --.- L"
                                   Foreground="#FFD2D9E0" FontSize="11" Margin="0,4,0,0" />
                        <TextBlock x:Name="BrakeBiasText" Text="BRAKE BIAS --.-%"
                                   Foreground="#FFD2D9E0" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Margin="5,3" Padding="8,3"
                            Background="#FF0B0E0F"
                            BorderBrush="#FF3C4246" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="SpeedText" Text="--- KM/H"
                                   Foreground="#FFE1E5E7" FontSize="20"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <Border x:Name="PitLimiterIndicator"
                                Visibility="Collapsed"
                                Background="#FFFF8728"
                                BorderBrush="#FFFFC247"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="10,2"
                                Margin="0,2,0,0"
                                HorizontalAlignment="Center">
                            <TextBlock Text="PIT LIMITER"
                                       Foreground="#FF07090A"
                                       FontSize="11"
                                       FontWeight="Bold" />
                        </Border>
                        <TextBlock x:Name="GearText" Text="N"
                                   Foreground="White" FontSize="76" FontWeight="Bold"
                                   LineHeight="70" HorizontalAlignment="Center" />
                        <TextBlock x:Name="RpmText" Text="RPM ----"
                                   Foreground="#FFD2D9E0" FontSize="12"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Margin="3" Padding="9"
                            Background="#FF121617"
                            BorderBrush="#FF343A3D" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="CurrentLapText" Text="CURRENT --:--.---"
                                   Foreground="White" FontSize="12" />
                        <TextBlock x:Name="LastLapText" Text="LAST --:--.---"
                                   Foreground="#FFD2D9E0" FontSize="11" Margin="0,3,0,0" />
                        <TextBlock x:Name="BestLapText" Text="BEST --:--.---"
                                   Foreground="#FF42D3A6" FontSize="11" Margin="0,2,0,0" />
                        <primitives:UniformGrid Columns="4" Margin="0,8,0,0">
                            <Border x:Name="TcIndicator" Padding="5,4" CornerRadius="3"
                                    Background="#FF202A33" Margin="0,0,3,0">
                                <StackPanel>
                                    <TextBlock x:Name="TcIndicatorText" Text="TC"
                                               Foreground="#FF788795" FontWeight="Bold"
                                               FontSize="9" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TcLevelText" Text="--"
                                               Foreground="White" FontWeight="Bold"
                                               FontSize="15" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Padding="5,4" CornerRadius="3"
                                    Background="#FF202A33" Margin="0,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="SLIP" Foreground="#FF788795"
                                               FontWeight="Bold" FontSize="9"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TcSlipLevelText" Text="--"
                                               Foreground="White" FontWeight="Bold"
                                               FontSize="15" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Padding="5,4" CornerRadius="3"
                                    Background="#FF202A33" Margin="0,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="CUT" Foreground="#FF788795"
                                               FontWeight="Bold" FontSize="9"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TcCutLevelText" Text="--"
                                               Foreground="White" FontWeight="Bold"
                                               FontSize="15" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="AbsIndicator" Padding="5,4" CornerRadius="3"
                                    Background="#FF202A33">
                                <StackPanel>
                                    <TextBlock x:Name="AbsIndicatorText" Text="ABS"
                                               Foreground="#FF788795" FontWeight="Bold"
                                               FontSize="9" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="AbsLevelText" Text="--"
                                               Foreground="White" FontWeight="Bold"
                                               FontSize="15" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </primitives:UniformGrid>
                        <TextBlock x:Name="EngineTempsText" Text="OIL --°  WATER --°"
                                   Foreground="#FFD2D9E0" FontSize="10" Margin="0,6,0,0" />
                    </StackPanel>
                    </Border>
                </Grid>
                <Grid Grid.Row="3" Margin="24,6,24,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="54" Height="44"
                            HorizontalAlignment="Left"
                            Background="#FF15191B" BorderBrush="#FF343A3D"
                            BorderThickness="1">
                        <TextBlock Text="RF" Foreground="#FFF1F3F4"
                                   FontWeight="Bold" FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1" Background="#FF15191B"
                            BorderBrush="#FFE1972F" BorderThickness="1">
                        <Grid>
                            <Border Height="16" VerticalAlignment="Top"
                                    Margin="0,-13,0,0" Panel.ZIndex="2"
                                    Background="#FFD78421">
                                <TextBlock Text="TYRE TEMP / WEAR" Foreground="White"
                                           FontSize="9" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Grid Margin="22,2,22,1">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <Grid Width="10" Height="17">
                                        <Border x:Name="FrontLeftTireIcon"
                                                CornerRadius="3"
                                                Background="#FF485460" />
                                        <Rectangle Height="1" Margin="2,0"
                                                   Fill="#99070B0D"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="FrontLeftTireText"
                                               Text="FL --° · D --%" Foreground="#FFE7EAEC"
                                               FontSize="11" FontWeight="SemiBold"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <Grid Width="10" Height="17">
                                        <Border x:Name="FrontRightTireIcon"
                                                CornerRadius="3"
                                                Background="#FF485460" />
                                        <Rectangle Height="1" Margin="2,0"
                                                   Fill="#99070B0D"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="FrontRightTireText"
                                               Text="FR --° · D --%" Foreground="#FFE7EAEC"
                                               FontSize="11" FontWeight="SemiBold"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <Grid Width="10" Height="17">
                                        <Border x:Name="RearLeftTireIcon"
                                                CornerRadius="3"
                                                Background="#FF485460" />
                                        <Rectangle Height="1" Margin="2,0"
                                                   Fill="#99070B0D"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="RearLeftTireText"
                                               Text="RL --° · D --%" Foreground="#FFE7EAEC"
                                               FontSize="11" FontWeight="SemiBold"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <Grid Width="10" Height="17">
                                        <Border x:Name="RearRightTireIcon"
                                                CornerRadius="3"
                                                Background="#FF485460" />
                                        <Rectangle Height="1" Margin="2,0"
                                                   Fill="#99070B0D"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="RearRightTireText"
                                               Text="RR --° · D --%" Foreground="#FFE7EAEC"
                                               FontSize="11" FontWeight="SemiBold"
                                               Margin="5,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="EditHint" Grid.Column="2"
                               Text="ARRASTE · REDIMENSIONE"
                               Foreground="#FFFFCA6A" FontSize="9"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Visibility="Collapsed" />
                </Grid>
                    </Grid>
                </Viewbox>
                <primitives:Thumb x:Name="ResizeThumb"
                                  Tag="DiagnosticWidget"
                                  Width="18" Height="18"
                                  Panel.ZIndex="10"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Cursor="SizeNWSE"
                                  Background="#FFFFCA6A"
                                  Visibility="Collapsed"
                                  DragDelta="ResizeThumbDragDelta"
                                  DragCompleted="ResizeThumbDragCompleted" />
            </Grid>
        </Border>
        <Border x:Name="InputsWidget" Padding="10" CornerRadius="8"
                Background="#DD101820" BorderBrush="#FF42D3A6" BorderThickness="1"
                MouseLeftButtonDown="WidgetMouseLeftButtonDown"
                MouseMove="WidgetMouseMove"
                MouseLeftButtonUp="WidgetMouseLeftButtonUp">
            <Grid>
                <StackPanel>
                    <TextBlock Text="INPUTS" Foreground="#FF42D3A6" FontWeight="Bold" FontSize="11" />
                    <TextBlock x:Name="InputsText" Text="THR --  BRK --  STR --"
                               Foreground="White" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>
                <primitives:Thumb x:Name="InputsResizeThumb" Tag="InputsWidget"
                                  Width="18" Height="18" Panel.ZIndex="10"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Cursor="SizeNWSE" Background="#FFFFCA6A"
                                  Visibility="Collapsed"
                                  DragDelta="ResizeThumbDragDelta"
                                  DragCompleted="ResizeThumbDragCompleted" />
            </Grid>
        </Border>
        <Border x:Name="LiveStandingsWidget" Padding="0" CornerRadius="4"
                Background="#F5070B18" BorderThickness="0"
                MouseLeftButtonDown="WidgetMouseLeftButtonDown"
                MouseMove="WidgetMouseMove"
                MouseLeftButtonUp="WidgetMouseLeftButtonUp">
            <Grid>
                <Viewbox Stretch="Fill">
                    <Grid Width="260" Height="410" Background="#F5070B18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Background="#FF17213B">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="P" />
                            <TextBlock Grid.Column="1" Text="MFR" />
                            <TextBlock Grid.Column="2" Text="NO." />
                            <TextBlock Grid.Column="3" Text="DRV" />
                            <TextBlock Grid.Column="4" Text="LAST LAP" />
                            <TextBlock Grid.Column="5" Text="INTERVAL"
                                       HorizontalAlignment="Right" Margin="0,0,8,0" />
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="FontFamily" Value="Bahnschrift" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="FontSize" Value="8" />
                                    <Setter Property="Foreground" Value="#FF8292A4" />
                                </Style>
                            </Grid.Resources>
                        </Grid>
                        <StackPanel x:Name="StandingsRows" Grid.Row="1" />
                    </Grid>
                </Viewbox>
                <primitives:Thumb x:Name="LiveStandingsResizeThumb" Tag="LiveStandingsWidget"
                                  Width="18" Height="18" Panel.ZIndex="10"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Cursor="SizeNWSE" Background="#FFFFCA6A"
                                  Visibility="Collapsed"
                                  DragDelta="ResizeThumbDragDelta"
                                  DragCompleted="ResizeThumbDragCompleted" />
            </Grid>
        </Border>
        <Border x:Name="RelativeWidget" Padding="0" CornerRadius="4"
                Background="#F5070B18" BorderThickness="0"
                MouseLeftButtonDown="WidgetMouseLeftButtonDown"
                MouseMove="WidgetMouseMove"
                MouseLeftButtonUp="WidgetMouseLeftButtonUp">
            <Grid>
                <Viewbox Stretch="Fill">
                    <Grid Width="260" Height="410" Background="#F5070B18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#FF1B2441">
                            <Grid Margin="10,0">
                                <TextBlock Text="RELATIVE" Foreground="White"
                                           FontFamily="Bahnschrift"
                                           FontWeight="Bold" FontSize="14"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="GAP" Foreground="#FF91A0B7"
                                           FontFamily="Bahnschrift"
                                           FontWeight="Bold" FontSize="9"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <StackPanel x:Name="RelativeRows" Grid.Row="1" />
                    </Grid>
                </Viewbox>
                <primitives:Thumb x:Name="RelativeResizeThumb" Tag="RelativeWidget"
                                  Width="18" Height="18" Panel.ZIndex="10"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Cursor="SizeNWSE" Background="#FFFFCA6A"
                                  Visibility="Collapsed"
                                  DragDelta="ResizeThumbDragDelta"
                                  DragCompleted="ResizeThumbDragCompleted" />
            </Grid>
        </Border>
        <Border x:Name="SessionFlagsWidget" Padding="0" CornerRadius="4"
                Background="#F20A0F1A" BorderBrush="#FF53627B" BorderThickness="1"
                MouseLeftButtonDown="WidgetMouseLeftButtonDown"
                MouseMove="WidgetMouseMove"
                MouseLeftButtonUp="WidgetMouseLeftButtonUp">
            <Grid>
                <Viewbox Stretch="Fill">
                    <Grid Width="500" Height="190" Background="#F20A0F1A">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="108" />
                            <RowDefinition Height="48" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#FF1B2441">
                            <Grid Margin="12,0">
                                <TextBlock x:Name="SessionNameText" Text="SESSION"
                                           Foreground="White" FontFamily="Bahnschrift"
                                           FontWeight="Bold" FontSize="13"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="SessionMetaText"
                                           Text="--:--  ·  LAP --"
                                           Foreground="#FFAFBAC9" FontFamily="Bahnschrift"
                                           FontWeight="SemiBold" FontSize="10"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" Margin="10,8,10,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="GripCard" Grid.Column="0"
                                    Background="#FF182131"
                                    BorderBrush="#FF4B5B72" BorderThickness="1"
                                    CornerRadius="3">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="TRACK GRIP"
                                               Foreground="#FFAFBAC9"
                                               FontFamily="Bahnschrift"
                                               FontSize="9"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="GripValueText"
                                               Text="UNKNOWN"
                                               Foreground="White"
                                               FontFamily="Bahnschrift"
                                               FontSize="18" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,5,0,0" />
                                    <TextBlock Text="REALROAD"
                                               Foreground="#FF7E8B9D"
                                               FontFamily="Bahnschrift"
                                               FontSize="8"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="WeatherCard" Grid.Column="2"
                                    Background="#FF182131"
                                    BorderBrush="#FF4B5B72" BorderThickness="1"
                                    CornerRadius="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="WeatherIconText"
                                               Text="☁"
                                               Foreground="#FFB7D8FF"
                                               FontFamily="Segoe UI Symbol"
                                               FontSize="31"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="WEATHER"
                                                   Foreground="#FFAFBAC9"
                                                   FontFamily="Bahnschrift"
                                                   FontSize="9" />
                                        <TextBlock x:Name="WeatherNameText"
                                                   Text="NO DATA"
                                                   Foreground="White"
                                                   FontFamily="Bahnschrift"
                                                   FontSize="14" FontWeight="Bold" />
                                        <TextBlock x:Name="WeatherDetailText"
                                                   Text="RAIN --%  ·  WET --%"
                                                   Foreground="#FF93A4B9"
                                                   FontFamily="Bahnschrift"
                                                   FontSize="8" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border x:Name="FlagCard" Grid.Column="4"
                                    Background="#FF34404D"
                                    BorderBrush="#FF647386" BorderThickness="1"
                                    CornerRadius="3">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="FLAG"
                                               Foreground="#FFD5DCE5"
                                               FontFamily="Bahnschrift"
                                               FontSize="9"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="FlagCardText"
                                               Text="NO DATA"
                                               Foreground="White"
                                               FontFamily="Bahnschrift"
                                               FontSize="18" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="2" Background="#FF111827">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="AIR" Foreground="#FF8492A6"
                                           FontFamily="Bahnschrift" FontSize="8" />
                                <TextBlock x:Name="AmbientTemperatureText"
                                           Text="--°C" Foreground="White"
                                           FontFamily="Bahnschrift"
                                           FontSize="15" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="TRACK" Foreground="#FF8492A6"
                                           FontFamily="Bahnschrift" FontSize="8" />
                                <TextBlock x:Name="TrackTemperatureText"
                                           Text="--°C" Foreground="#FFFFC45A"
                                           FontFamily="Bahnschrift"
                                           FontSize="15" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
