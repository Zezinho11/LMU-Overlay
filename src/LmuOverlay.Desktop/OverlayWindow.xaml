<Window x:Class="LmuOverlay.Desktop.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="LMU Overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">
    <Canvas x:Name="OverlayCanvas" Background="Transparent">
        <Border x:Name="DiagnosticWidget"
                MinWidth="170"
                MinHeight="100"
                Padding="12"
                CornerRadius="8"
                Background="#DD101820"
                BorderBrush="#FF42D3A6"
                BorderThickness="1"
                MouseLeftButtonDown="WidgetMouseLeftButtonDown"
                MouseMove="WidgetMouseMove"
                MouseLeftButtonUp="WidgetMouseLeftButtonUp">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="LMU LIVE" Foreground="#FF42D3A6"
                               FontWeight="Bold" FontSize="12" />
                    <TextBlock x:Name="ConnectionText" DockPanel.Dock="Right"
                               Text="AGUARDANDO" Foreground="#FFAAB7C4"
                               FontSize="10" HorizontalAlignment="Right" />
                </DockPanel>
                <StackPanel Grid.Row="1" Margin="0,8,0,4">
                    <TextBlock x:Name="SpeedText" Text="--- km/h"
                               Foreground="White" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock x:Name="DetailText" Text="Abra o Le Mans Ultimate"
                               Foreground="#FFD2D9E0" FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DeltaText" Text="DELTA --"
                               Foreground="#FFFFCA6A" FontSize="13"
                               FontWeight="Bold" Margin="0,4,0,0" />
                    <TextBlock x:Name="TiresText" Text="FL --°  FR --°  RL --°  RR --°"
                               Foreground="#FFD2D9E0" FontSize="11"
                               Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock x:Name="EditHint" Grid.Row="2"
                           Text="ARRASTE • REDIMENSIONE PELO CANTO"
                           Foreground="#FFFFCA6A" FontSize="9"
                           Visibility="Collapsed" />
                <primitives:Thumb x:Name="ResizeThumb" Grid.RowSpan="3"
                                  Tag="DiagnosticWidget"
                                  Width="18" Height="18"
                                  Panel.ZIndex="10"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Cursor="SizeNWSE"
                                  Background="#FFFFCA6A"
                                  Visibility="Collapsed"
                                  DragDelta="ResizeThumbDragDelta"
                                  DragCompleted="ResizeThumbDragCompleted" />
            </Grid>
        </Border>
        <Border x:Name="InputsWidget" Padding="10" CornerRadius="8"
                Background="#DD101820" BorderBrush="#FF42D3A6" BorderThickness="1"
                MouseLeftButtonDown="WidgetMouseLeftButtonDown"
                MouseMove="WidgetMouseMove"
                MouseLeftButtonUp="WidgetMouseLeftButtonUp">
            <Grid>
                <StackPanel>
                    <TextBlock Text="INPUTS" Foreground="#FF42D3A6" FontWeight="Bold" FontSize="11" />
                    <TextBlock x:Name="InputsText" Text="THR --  BRK --  STR --"
                               Foreground="White" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>
                <primitives:Thumb x:Name="InputsResizeThumb" Tag="InputsWidget"
                                  Width="18" Height="18" Panel.ZIndex="10"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Cursor="SizeNWSE" Background="#FFFFCA6A"
                                  Visibility="Collapsed"
                                  DragDelta="ResizeThumbDragDelta"
                                  DragCompleted="ResizeThumbDragCompleted" />
            </Grid>
        </Border>
        <Border x:Name="LiveStandingsWidget" Padding="10" CornerRadius="8"
                Background="#DD101820" BorderBrush="#FF42D3A6" BorderThickness="1"
                MouseLeftButtonDown="WidgetMouseLeftButtonDown"
                MouseMove="WidgetMouseMove"
                MouseLeftButtonUp="WidgetMouseLeftButtonUp">
            <Grid>
                <StackPanel>
                    <TextBlock Text="LIVE STANDINGS" Foreground="#FF42D3A6"
                               FontWeight="Bold" FontSize="11" />
                    <StackPanel x:Name="StandingsRows" Margin="0,6,0,0" />
                </StackPanel>
                <primitives:Thumb x:Name="LiveStandingsResizeThumb" Tag="LiveStandingsWidget"
                                  Width="18" Height="18" Panel.ZIndex="10"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Cursor="SizeNWSE" Background="#FFFFCA6A"
                                  Visibility="Collapsed"
                                  DragDelta="ResizeThumbDragDelta"
                                  DragCompleted="ResizeThumbDragCompleted" />
            </Grid>
        </Border>
        <Border x:Name="RelativeWidget" Padding="10" CornerRadius="8"
                Background="#DD101820" BorderBrush="#FF42D3A6" BorderThickness="1"
                MouseLeftButtonDown="WidgetMouseLeftButtonDown"
                MouseMove="WidgetMouseMove"
                MouseLeftButtonUp="WidgetMouseLeftButtonUp">
            <Grid>
                <StackPanel>
                    <TextBlock Text="RELATIVE" Foreground="#FF42D3A6"
                               FontWeight="Bold" FontSize="11" />
                    <StackPanel x:Name="RelativeRows" Margin="0,6,0,0" />
                </StackPanel>
                <primitives:Thumb x:Name="RelativeResizeThumb" Tag="RelativeWidget"
                                  Width="18" Height="18" Panel.ZIndex="10"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Cursor="SizeNWSE" Background="#FFFFCA6A"
                                  Visibility="Collapsed"
                                  DragDelta="ResizeThumbDragDelta"
                                  DragCompleted="ResizeThumbDragCompleted" />
            </Grid>
        </Border>
        <Border x:Name="SessionFlagsWidget" Padding="10" CornerRadius="8"
                Background="#DD101820" BorderBrush="#FF42D3A6" BorderThickness="1"
                MouseLeftButtonDown="WidgetMouseLeftButtonDown"
                MouseMove="WidgetMouseMove"
                MouseLeftButtonUp="WidgetMouseLeftButtonUp">
            <Grid>
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="SessionNameText" Text="SESSION"
                                   Foreground="#FF42D3A6" FontWeight="Bold" FontSize="11" />
                        <TextBlock x:Name="FlagText" Text="NO DATA" DockPanel.Dock="Right"
                                   HorizontalAlignment="Right" Foreground="#FFAAB7C4"
                                   FontWeight="Bold" FontSize="11" />
                    </DockPanel>
                    <TextBlock x:Name="SessionDetailText"
                               Text="--:--  LAP --  AIR --°  TRACK --°"
                               Foreground="White" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>
                <primitives:Thumb x:Name="SessionFlagsResizeThumb" Tag="SessionFlagsWidget"
                                  Width="18" Height="18" Panel.ZIndex="10"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Cursor="SizeNWSE" Background="#FFFFCA6A"
                                  Visibility="Collapsed"
                                  DragDelta="ResizeThumbDragDelta"
                                  DragCompleted="ResizeThumbDragCompleted" />
            </Grid>
        </Border>
    </Canvas>
</Window>
