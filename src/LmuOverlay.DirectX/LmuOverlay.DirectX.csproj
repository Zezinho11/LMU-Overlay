<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\LmuOverlay.Configuration\LmuOverlay.Configuration.csproj" />
    <ProjectReference Include="..\LmuOverlay.Core\LmuOverlay.Core.csproj" />
    <ProjectReference Include="..\LmuOverlay.Widgets\LmuOverlay.Widgets.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\steering-wheel.png"
                      LogicalName="LmuOverlay.DirectX.Assets.steering-wheel.png" />
    <EmbeddedResource Include="Assets\steering-wheel-bgra.bin"
                      LogicalName="LmuOverlay.DirectX.Assets.steering-wheel-bgra.bin" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
